  "item": [
    {
      "name": "Successful Sign In",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Assert status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Assert response contains email', function () {",
              "  const jsonData = pm.response.json();",
              "  const email = (\"a.morgan@qa.team\");",
              "",
              "  pm.expect(jsonData.user.email)",
              "    .to.eql(email);",
              "});",
              "",
              "pm.test('Assert response contains empty bio', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect(jsonData.user.bio).to.eql('');",
              "});",
              "",
              "pm.test('Assert response contains empty image', function () {",
              "  const jsonData = pm.response.json();",
              "  pm.expect('')",
              "    .to.eql('');",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": {\n    \"email\": \"a.morgan@qa.team\",\n    \"password\": \"W@lterWh1te\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/users/login",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Sign In with non-existing email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Fix the code below to check status code in reponse.",
              "pm.test('Assert status code is 422', function () {",
              "  pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test('Assert response contains validation message', function () {",
              "  const jsonData = pm.response.json();",
              "",
              "  pm.expect(jsonData.errors['email or password'])",
              "    .to.eql(\"is invalid\");",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
