              "    pm.test(\"comentario criado\", function () {\r",
              "        pm.expect(response.comment.body).to.eql(\"esse é meu comentario\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"comentario possui ID\", function () {\r",
              "        pm.expect(response.comment.id).to.exist;\r",
