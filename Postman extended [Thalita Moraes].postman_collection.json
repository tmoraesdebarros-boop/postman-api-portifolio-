  "item": [
    {
      "name": "Registro",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('assert status code is 200', ()=> {\r",
              "       pm.response.to.have.status(200)\r",
              "\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status Code é 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"O objeto user existe\", () => {\r",
              "    pm.expect(response).to.have.property(\"user\");\r",
              "});\r",
              "\r",
              "pm.test(\"O usuário possui username\", () => {\r",
              "    pm.expect(response.user).to.have.property(\"username\");\r",
              "    pm.expect(response.user.username).to.be.a(\"string\");\r",
              "    pm.expect(response.user.username).to.include(\"novousuario_\");\r",
              "});\r",
              "\r",
              "pm.test(\"O usuário possui email\", () => {\r",
              "    pm.expect(response.user).to.have.property(\"email\");\r",
              "    pm.expect(response.user.email).to.be.a(\"string\");\r",
              "    pm.expect(response.user.email).to.include(\"@post.com\");\r",
              "});\r",
              "\r",
              "pm.test(\"O usuário possui token\", () => {\r",
              "    pm.expect(response.user).to.have.property(\"token\");\r",
              "    pm.expect(response.user.token).to.be.a(\"string\");\r",
              "    pm.expect(response.user.token).to.not.be.empty;\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorization_secret}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": {\n    \"username\": \"novousuario_{{$randomInt}}\",\n    \"email\": \"novoemail{{$randomInt}}@post.com\",\n    \"password\": \"{{passwordConduit}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
