    {
      "name": "Criar um artigo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.test(\"Título\", function () {\r",
              "        pm.expect(response.article.title).to.include(\"Meu artigo\");\r",
              "    });\r",
              "\r",
              "\r",
              "const responseData = pm.response.json();\r",
              "\r",
              "\r",
              "const articleSlug = responseData.article.slug;\r",
              "\r",
              "\r",
              "pm.collectionVariables.set(\"articleSlug\", articleSlug);\r",
              "   \r",
              "    \r",
              "}\r",
              "   "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
